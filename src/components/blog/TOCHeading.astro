---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, slug, text },
} = Astro.props;
---

<li class="list-inside list-disc px-6 py-1.5 text-sm">
	<a class="micro-link" href={`#${slug}`}>{text}</a>
	{
		!!children.length && (
			<ul class="translate-x-3">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
