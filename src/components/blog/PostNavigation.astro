---
import type { CollectionEntry } from "astro:content";

interface Props {
	newer?: CollectionEntry<"post"> | undefined;
	older?: CollectionEntry<"post"> | undefined;
}

const { newer, older } = Astro.props;
---

<nav aria-label="More posts" class="not-prose grid grid-cols-2 gap-1.5 sm:gap-3">
	{
		older ? (
			<a class="micro-surface group relative flex px-4 py-3 ps-10" href={`/${older.id}/`}>
				<svg
					aria-hidden="true"
					class="absolute start-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<line
						class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100"
						x1="5"
						x2="19"
						y1="12"
						y2="12"
					/>
					<polyline
						class="translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0"
						points="12 5 5 12 12 19"
					/>
				</svg>
				<span class="flex flex-col text-sm">
					<span class="text-muted text-xs">Older</span>
					{older.data.title}
				</span>
			</a>
		) : (
			<div />
		)
	}
	{
		newer ? (
			<a
				class="micro-surface group relative flex justify-end px-4 py-3 pe-10 text-end"
				href={`/${newer.id}/`}
			>
				<svg
					aria-hidden="true"
					class="absolute end-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<line
						class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100"
						x1="5"
						x2="19"
						y1="12"
						y2="12"
					/>
					<polyline
						class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0"
						points="12 5 19 12 12 19"
					/>
				</svg>
				<span class="flex flex-col text-sm">
					<span class="text-muted text-xs">Newer</span>
					{newer.data.title}
				</span>
			</a>
		) : (
			<div />
		)
	}
</nav>
