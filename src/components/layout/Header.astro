---
import { Image } from "astro:assets";
import avatar from "@/assets/dp.png";
import Container from "@/components/Container.astro";
import Search from "@/components/Search.astro";
import { menuLinks, siteConfig } from "@/site.config";

const current = Astro.url.pathname;
---

<header
	class="fixed inset-x-0 top-0 z-50 bg-neutral-100/75 py-5 saturate-200 backdrop-blur-xs dark:bg-neutral-900/75"
>
	<Container>
		<div class="flex flex-wrap items-center justify-between gap-y-2">
			<a
				aria-current={current === "/" ? "page" : false}
				class="flex items-center gap-2.5 font-semibold text-black dark:text-white"
				href="/"
			>
				{
					siteConfig.showLogo && (
						<Image
							alt=""
							class="size-8 rounded-full"
							densities={[1, 2]}
							loading="eager"
							src={avatar}
							width={32}
						/>
					)
				}
				{siteConfig.title}
			</a>
			<nav aria-label="Main" class="flex items-center gap-1.5 text-sm">
				{
					menuLinks.map((link) => (
						<>
							<a
								aria-current={current === link.path ? "page" : false}
								class="micro-link aria-[current=page]:text-black dark:aria-[current=page]:text-white"
								href={link.path}
							>
								{link.title.toLowerCase()}
							</a>
							<span aria-hidden="true">/</span>
						</>
					))
				}
				<Search />
			</nav>
		</div>
	</Container>
</header>
