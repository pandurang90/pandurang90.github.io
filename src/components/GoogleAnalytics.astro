---
import { siteConfig } from "@/site.config";

// Set siteConfig.googleAnalyticsId to your GA4 Measurement ID (format: G-XXXXXXXXXX).
// Left empty, this renders nothing — so dev builds and previews stay untracked.
const id = siteConfig.googleAnalyticsId;
---

{
	id && import.meta.env.PROD && (
		<>
			<script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
			<script define:vars={{ id }} is:inline>
				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag("js", new Date());
				gtag("config", id);
			</script>
		</>
	)
}
