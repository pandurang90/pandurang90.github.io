---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import ArrowCard from "@/components/ArrowCard.astro";
import Container from "@/components/Container.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const allPostsByDate = (await getAllPosts()).sort(collectionDateSort);
	return paginate(allPostsByDate, { pageSize: MAX_POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
}

const { page } = Astro.props;

const meta = {
	description: "Read my collection of posts and the things that interest me",
	title: "Posts",
};

const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "Newer posts", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "Older posts", url: page.url.next } }),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<Container>
		<div class="animate mb-10 flex flex-wrap items-center justify-between gap-y-2">
			<h1 class="text-2xl font-semibold text-black dark:text-white">Posts</h1>
			<div class="flex items-center gap-1.5 text-sm">
				<a class="micro-link" href="/tags/">tags</a>
				<span aria-hidden="true">/</span>
				<a class="micro-link" href="/feed.xml">rss</a>
			</div>
		</div>
		<div class="space-y-10" data-pagefind-ignore>
			{
				descYearKeys.map((yearKey) => (
					<section class="animate space-y-4">
						<h2 class="font-semibold text-black dark:text-white" id={`year-${yearKey}`}>
							<span class="sr-only">Posts in</span>
							{yearKey}
						</h2>
						<ul class="flex flex-col gap-4">
							{groupedByYear[yearKey]?.map((p) => (
								<li>
									<ArrowCard description={p.data.description} href={`/${p.id}/`} title={p.data.title} />
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
		<Pagination {...paginationProps} />
	</Container>
</PageLayout>
