---
import BackToPrevious from "@/components/BackToPrevious.astro";
import Container from "@/components/Container.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Oops! It looks like this page is lost in space!",
	title: "Page not found",
};
---

<PageLayout meta={meta}>
	<Container>
		<div class="mt-16 grid place-items-center gap-4">
			<h1 class="animate text-2xl font-semibold text-black dark:text-white">404: Page not found</h1>
			<div class="animate"><BackToPrevious href="/">Go to home page</BackToPrevious></div>
		</div>
	</Container>
</PageLayout>
