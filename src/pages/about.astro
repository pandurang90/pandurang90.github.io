---
import Container from "@/components/Container.astro";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Software craftsman with 14+ years building scalable backend systems and 6+ years leading engineering teams in Fintech and Consumer Tech.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<Container>
		<h1 class="animate mb-10 text-2xl font-semibold text-black dark:text-white">About</h1>
		<div class="animate prose max-w-none">
			<p>
				Software craftsman with 14+ years of experience building scalable backend systems, and 6+ years leading and growing engineering teams in Fintech and Consumer Tech. Track record of owning end-to-end delivery, managing engineering budgets, and building high-performing teams from hiring through mentorship. Proven ability to architect fault-tolerant, high-throughput distributed systems — and the organisational discipline to ship them reliably at scale.
			</p>
			<h2>Contact</h2>
			<p>
				The fastest way to reach me is email:{" "}
				<a href="mailto:pandurang.plw@gmail.com">pandurang.plw@gmail.com</a>. You’ll also find me on{" "}
				<a href="https://github.com/pandurang90" rel="noreferrer" target="_blank">GitHub</a> and{" "}
				<a href="https://www.linkedin.com/in/pandurangwaghulde" rel="noreferrer" target="_blank">LinkedIn</a>.
			</p>
		</div>
	</Container>
</PageLayout>
