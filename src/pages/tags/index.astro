---
import Container from "@/components/Container.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allTags = getUniqueTagsWithCount(await getAllPosts());

const meta = {
	description: "A list of all the topics I've written about in my posts",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<Container>
		<div class="space-y-10">
			<h1 class="animate text-2xl font-semibold text-black dark:text-white">All tags</h1>
			<ul class="animate flex flex-wrap gap-2">
				{
					allTags.map(([tag, count]) => (
						<li>
							<a
								class="micro-surface inline-block rounded-sm px-2 py-1 text-sm"
								href={`/tags/${tag}/`}
								title={`View posts with the tag: ${tag}`}
							>
								{tag} <span class="text-muted">({count})</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</Container>
</PageLayout>
